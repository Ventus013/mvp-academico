{
  "name": "academic-production-catalog",
  "version": "1.0.0",
  "private": true,
  "description": "API acadêmica independente para catálogo de produtos e processos genéricos",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:production": "npm run db:migrate && npm run db:seed && npm start",
    "start:dev": "ts-node src/main.ts",
    "db:migrate": "ts-node scripts/migrate.ts",
    "db:seed": "ts-node scripts/seed.ts",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:postgres": "node scripts/require-test-db.cjs && jest --runInBand",
    "typecheck": "tsc --noEmit",
    "validate:isolated": "node scripts/validate-isolated.cjs",
    "demo": "npm run build && node scripts/validate-isolated.cjs --serve",
    "test:ui": "npm run build && node scripts/validate-isolated.cjs --browser",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.0.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.0",
    "jest": "^30.0.0",
    "pg-mem": "^3.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.0"
  }
}
